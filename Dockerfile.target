
FROM golang:1.24-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o target-server ./examples/target-server

FROM alpine:3.22

WORKDIR /app

COPY --from=builder /app/target-server /app/target-server

EXPOSE 9001

ENTRYPOINT ["/app/target-server"]
