# Auto detect text files and perform LF normalization
* text=auto

# Enforce LF line endings for Go code, configs, and web source
*.go text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# GitHub Linguist language statistics overrides (highlight Go core)
web/** linguist-detectable=false
*.html linguist-detectable=false
*.ts linguist-detectable=false
*.tsx linguist-detectable=false
*.css linguist-detectable=false
